# OpenAI 兼容接口（DeepSeek 等），复制本文件为 .env 后填写
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Redis（可选，未配置时自动降级）
REDIS_URL=redis://localhost:6379/0

# PostgreSQL（可选，默认内存模式）
PG_DSN=postgresql://postgres:postgres@localhost:5432/agentservice

# Java 工单服务（对话 → 自动建单闭环；需先启动 java-ticket-service）
TICKET_SERVICE_URL=http://127.0.0.1:8080
